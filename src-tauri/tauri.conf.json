{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "schumaz.gg",
  "version": "0.1.0",
  "identifier": "com.schumaz.schumazgg",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "schumaz.gg",
        "width": 980,
        "height": 720,
        "minWidth": 840,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "schumaZ",
    "copyright": "Copyright © 2026 schumaZ",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Automated League of Legends companion app for builds, runes, spells, and stats.",
    "longDescription": "schumaz.gg is a League of Legends desktop companion app that automatically injects recommended runes, summoner spells, and item sets during Champion Select, plus ranked tier lists, ARAM & ARAM Mayhem builds, and summoner profile analytics.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "nsis/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxNjZGOTAzQUZEQzY4QjkKUldTNWFOeXZBL2xtOFZSRFRnZUJ6OWNHTWhNeE9SYi9YTENQTzgvakR2N050RUZyZmsyUDF3K3oK",
      "endpoints": [
        "https://github.com/schumaz/schumaz.gg/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
