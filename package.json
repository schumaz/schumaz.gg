{
  "name": "schumazgg",
  "private": true,
  "version": "0.3.3",
  "description": "Automated League of Legends companion app for builds, runes, spells, item sets, and summoner stats.",
  "author": "schumaZ",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node --env-file-if-exists=.env ./node_modules/@tauri-apps/cli/tauri.js",
    "tauri:build": "node --env-file-if-exists=.env ./node_modules/@tauri-apps/cli/tauri.js build",
    "tauri:build:portable": "node --env-file-if-exists=.env ./node_modules/@tauri-apps/cli/tauri.js build --features portable --no-bundle",
    "build:desktop": "node --env-file-if-exists=.env scripts/build-desktop.mjs",
    "check:lines": "node scripts/check-line-limits.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
